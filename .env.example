PORT=5000
DATABASE_URL="file:./dev.db"
JWT_SECRET="your_jwt_secret_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# Stripe Payments Configuration
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Job Scraper Service
SCRAPER_SERVICE_URL="http://localhost:5001/api/scrape"

# Email SMTP Configuration (Nodemailer)
# Gmail: host=smtp.gmail.com, port=587, user=your-email@gmail.com, pass=16-digit-app-password
# SendGrid: host=smtp.sendgrid.net, port=587, user=apikey, pass=SG.xxx
# Resend: host=smtp.resend.com, port=465/587, user=resend, pass=re_xxx
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your_smtp_app_password"
SMTP_FROM="ResumeCraft AI <no-reply@resumecraft.com>"

# Pre-configured Admin Accounts
INITIAL_ADMIN_EMAILS="admin@example.com,superadmin@example.com"
INITIAL_ADMIN_PASSWORD="ChangeMeInProduction123!"
